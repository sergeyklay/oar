OAR_MEMORY_LIMIT=128MiB
DATABASE_URL=./data/oar.db

# Server Actions encryption key (required for consistent builds)
# Generate a key with: openssl rand -base64 32
# For docker-compose: This value is automatically used as the build secret
# For manual Docker: Use --secret id=next_key,env=NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="put your encryption key here"
