OAR_MEMORY_LIMIT=128MiB
DATABASE_URL=./data/oar.db

# Server Actions encryption key (optional)
# If set: Ensures Server Action IDs remain stable across builds (recommended for local/private builds)
# If not set: Next.js generates a random key (works for pre-built public images, but may cause version skew)
# Generate a key with: openssl rand -base64 32
# For pre-built images from public registry: Leave this empty - the image will work without it
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="put your encryption key here (or comment out for public images)"
